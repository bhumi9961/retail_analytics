# Copy this file to .env and change the values if needed.
# .env is ignored by Git, so your password never gets committed.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=retail_db
DB_USER=retail_user
DB_PASSWORD=retail_pass
MYSQL_ROOT_PASSWORD=root_pass

RAW_DIR=data/raw
CLEAN_DIR=data/cleaned
LOG_LEVEL=INFO
